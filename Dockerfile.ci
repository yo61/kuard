# syntax=docker/dockerfile:1
#
# Self-contained multi-arch CI build for ghcr.io/yo61/kuard, and the only Dockerfile in the repo:
# the upstream Makefile and the four Dockerfiles it drove targeted the dead gcr.io/kuar-demo via
# docker-in-docker volumes and were removed. The upstream 2019 build has rotted; this works around
# the one surviving breakage:
#   - jteeuwen/go-bindata was deleted from GitHub, so the original `go get` of it fails.
#     -> we install the community go-bindata/go-bindata fork (drop-in CLI) in the build stage.
#
# The 2019 Go deps compile on modern Go once golang.org/x/net is bumped (the old one used a
# //go:linkname into syscall that Go 1.26 rejects); that bump is in go.mod.
#
# Multi-arch strategy: the client (webpack) and Go stages are pinned to $BUILDPLATFORM so they
# always run natively -- never under QEMU. The webpack bundle and go-bindata codegen are
# arch-independent and happen once; only the final `go build` cross-compiles per target arch,
# which Go does at native speed. Result: a 3-arch image with no emulation anywhere.
#
# FAKEVER (blue/green/purple) is baked into the version string kuard shows in its UI -- that's
# what the book's rollout demos flip between.

# ---- Stage 1: React client (webpack 5) -> sitedata/built/bundle.js (built once, natively) ----
# node 24 is the active LTS, and webpack-dev-server 6 requires >= 22.15.0 anyway.
FROM --platform=$BUILDPLATFORM node:24-alpine AS client
WORKDIR /src
COPY client/ ./client/
COPY sitedata/ ./sitedata/
RUN cd client && npm ci --loglevel=error && npm run build

# ---- Stage 2: embed assets + cross-compile kuard for the target arch (runs on $BUILDPLATFORM) ----
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
# TARGET* are supplied by buildx per requested platform; GOARM comes from the arm variant (v7 -> 7).
ARG TARGETOS TARGETARCH TARGETVARIANT
ENV CGO_ENABLED=0 \
    GOFLAGS=-mod=mod \
    PKG=github.com/kubernetes-up-and-running/kuard
ARG FAKEVER=blue
WORKDIR /src
COPY . .
COPY --from=client /src/sitedata/built ./sitedata/built
# Shared cache mounts dedupe module downloads and build artifacts across the parallel arch builds.
# go-bindata + go:generate run native (no GOARCH override); only `go build` targets the arch.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go install github.com/go-bindata/go-bindata/go-bindata@latest \
 && go generate ./cmd/... ./pkg/... \
 && GOOS=$TARGETOS GOARCH=$TARGETARCH GOARM=${TARGETVARIANT#v} \
    go build -o /kuard -ldflags "-X ${PKG}/pkg/version.VERSION=${FAKEVER}" ./cmd/kuard

# ---- Stage 3: minimal runtime (built per target arch by buildx) ----
# Pinned rather than bare `alpine`: this is the base of the published
# ghcr.io/yo61/kuard image, and an unpinned tag both drifts silently between
# builds and gives Dependabot's docker ecosystem no version to bump.
FROM alpine:3.24
USER nobody:nobody
COPY --from=build /kuard /kuard
CMD ["/kuard"]
